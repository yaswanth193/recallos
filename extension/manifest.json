{
  "manifest_version": 3,
  "name": "RecallOS Screen & Learning Tracker",
  "version": "1.1.0",
  "description": "Capture screen snapshots, lecture videos, and learning materials directly into your RecallOS Knowledge Vault with built-in Privacy Guard.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture Screen with RecallOS"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "exclude_matches": [
        "*://*.whatsapp.com/*",
        "*://*.instagram.com/*",
        "*://*.facebook.com/*",
        "*://*.messenger.com/*",
        "*://*.telegram.org/*",
        "*://*.discord.com/*",
        "*://mail.google.com/*",
        "*://accounts.google.com/*",
        "*://*.paypal.com/*",
        "*://*.chase.com/*",
        "*://*.bankofamerica.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}
