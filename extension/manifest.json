{
  "manifest_version": 3,
  "name": "RecallOS Screen & Learning Tracker",
  "version": "1.2.0",
  "description": "Auto-captures learning activity from LeetCode, YouTube, MDN, and GitHub directly into your RecallOS Knowledge Vault with built-in Privacy Guard.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://*.supabase.co/*",
    "https://leetcode.com/*",
    "https://*.youtube.com/*",
    "https://*.github.com/*",
    "https://developer.mozilla.org/*",
    "https://*.medium.com/*",
    "https://*.geeksforgeeks.org/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "RecallOS Learning Tracker & Screen Capture"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "exclude_matches": [
        "*://*.whatsapp.com/*",
        "*://*.instagram.com/*",
        "*://*.facebook.com/*",
        "*://*.messenger.com/*",
        "*://*.telegram.org/*",
        "*://*.discord.com/*",
        "*://mail.google.com/*",
        "*://accounts.google.com/*",
        "*://*.paypal.com/*",
        "*://*.chase.com/*",
        "*://*.bankofamerica.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}
